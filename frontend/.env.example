# CampusFix AI — Frontend Environment Variables
#
# Copy this file to ".env" in this same folder (frontend/) and fill in 
# the values. Vite only reads .env files located inside frontend/ 
# (the folder containing vite.config.js). Do not place Vite env vars 
# in the repo root .env.example — that file is for backend-only secrets.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, or 
# GEMINI_API_KEY in this file. Those are backend-only.
#
# .env is gitignored. Do not commit it.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Supabase project URL (browser-safe)
VITE_SUPABASE_URL=

# Supabase anon/public key (browser-safe — NOT the service-role key)
VITE_SUPABASE_ANON_KEY=
